
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model products {
  id              BigInt   @id @default(autoincrement())
  external_id     String?  @unique
  source          String   @default("market")
  source_url      String?
  gorgia_url      String?
  name            String   @default("")
  name_ru         String?
  name_en         String?
  name_ka         String?
  description     String?
  description_ru  String?
  description_en  String?
  description_ka  String?
  price           Decimal? @db.Decimal(12, 2)
  cost_price      Decimal? @db.Decimal(12, 2)
  currency        String   @default("RUB")
  in_stock        Boolean  @default(true)
  stock           Int      @default(0)
  availability    String?
  availability_ru String?
  availability_ka String?  
  category        String?
  category_en     String?
  category_ka     String?
  category_key    String?
  sub_category    String?
  sub_category_en String?
  sub_category_ka String?
  sku             String?
  article         String?
  barcode         String?
  evotor_type     String   @default("NORMAL")
  evotor_uuid     String?
  vat             String?
  image_url       String?
  images          Json     @default("[]")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @db.Timestamptz(6)
  farmer_slug     String?
  farmer_name     String?
  producer_id     Int?
  region_id       Int?
  origin_type     String?

  product_translations product_translations[]

  @@index([source, category_key])
  @@index([source, sub_category])
  @@index([in_stock, updated_at])
}

model categories {
  id             BigInt       @id @default(autoincrement())
  name           String
  category_key   String       @unique
  parent_id      BigInt?
  category_image String?
  created_at     DateTime     @default(now()) @db.Timestamptz(6)
  name_en        String?
  name_ka        String?
  parent         categories?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children       categories[] @relation("CategoryParent")
}

model orders {
  id               Int       @id @default(autoincrement())
  referral_source  String?
  referral_comment String?
  customer   Json
  items      Json
  subtotal   Decimal?  @db.Decimal(10, 2)
  shipping   Decimal?  @db.Decimal(10, 2)
  total      Decimal?  @db.Decimal(10, 2)
  created_at DateTime? @default(now()) @db.Timestamptz(6)
}

model product_images {
  id         BigInt @id @default(autoincrement())
  product_id BigInt
  url        String
  position   Int?   @default(0)

  @@index([product_id], map: "idx_product_images_product_id")
}

model product_translations {
  id          BigInt  @id @default(autoincrement())
  product_id  BigInt
  lang        String
  name        String
  description String?

  product    products @relation(fields: [product_id], references: [id], onDelete: Cascade)

  @@unique([product_id, lang])
  @@index([product_id])
}

model subcategories {
  id           BigInt    @id @default(autoincrement())
  category_key String
  key          String    @unique
  name         String
  name_en      String?
  name_ka      String?
  image_url    String?
  created_at   DateTime? @default(now()) @db.Timestamptz(6)

  @@index([category_key])
}

model regions {
  id          Int       @id @default(autoincrement())
  slug        String    @unique
  name        String
  name_en     String?
  name_ka     String?
  description String?
  image_url   String?
  is_active   Boolean   @default(true)
  sort_order  Int       @default(100)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
}

model producers {
  id              Int       @id @default(autoincrement())
  slug            String    @unique
  name            String
  name_en         String?
  name_ka         String?
  region_id       Int?
  locality        String?
  description     String?
  description_en  String?
  description_ka  String?
  image_url       String?
  logo_url        String?
  website         String?
  instagram       String?
  facebook        String?
  status          String    @default("active")
  seo_title       String?
  seo_description String?
  sort_order      Int       @default(100)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @db.Timestamptz(6)

  @@index([region_id])
  @@index([status])
}

model producer_applications {
  id           Int      @id @default(autoincrement())
  contact_name String
  brand_name   String
  phone        String
  region       String?
  products     String
  social       String?
  description  String?
  status       String   @default("new")
  admin_note   String?
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  @@index([status])
}


