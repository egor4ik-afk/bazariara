generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model products {
  id              BigInt    @id @default(autoincrement())
  external_id     String?   @unique
  source          String    @default("market")
  source_url      String?
  gorgia_url      String?
  
  // Названия и описания
  name            String    @default("")
  name_ru         String?
  name_en         String?
  name_ka         String?
  description     String?
  description_ru  String?
  description_en  String?
  description_ka  String?
  
  // Цена и стоки
  price           Decimal?  @db.Decimal(12, 2)
  cost_price      Decimal?  @db.Decimal(12, 2)
  currency        String    @default("RUB")
  in_stock        Boolean   @default(true)
  stock           Int       @default(0)
  availability    String?
  
  // Категории
  category        String?
  category_en     String?
  category_ka     String?
  category_key    String?
  sub_category    String?
  sub_category_en String?
  sub_category_ka String?
  
  // Идентификаторы
  sku             String?
  article         String?
  barcode         String?
  
  // Эвотор
  evotor_type     String    @default("NORMAL")
  evotor_uuid     String?
  vat             String?
  
  // Картинки
  image_url       String?
  images          Json      @default("[]")

  created_at      DateTime  @default(now()) @db.Timestamptz
  updated_at      DateTime  @default(now()) @db.Timestamptz
}

model categories {
  id             BigInt       @id @default(autoincrement())
  name           String
  category_key   String       @unique
  parent_id      BigInt?
  parent         categories?  @relation("CategoryParent", fields: [parent_id], references: [id])
  children       categories[] @relation("CategoryParent")
  category_image String?
  created_at     DateTime     @default(now()) @db.Timestamptz
}